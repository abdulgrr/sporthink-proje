# Root Git ignore for mixed Flutter + Node.js workspace

# macOS
.DS_Store

# Windows
Thumbs.db

# IDE/editor files
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.swp

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Node.js
node_modules/
backend/node_modules/
backend/npm-debug.log*
backend/yarn-debug.log*
backend/pnpm-debug.log*

# Environment
.env
.env.*

# Flutter/Dart
.scratch/
.dart_tool/
.packages
.pub-cache/
.flutter-plugins
.flutter-plugins-dependencies
.flutter-plugins-dependencies
.flutter-credentials
.generated/

# Flutter build outputs
build/
**/build/
**/ios/Flutter/Flutter.framework
**/ios/Flutter/Flutter.podspec
**/ios/ServiceDefinitions.json
**/ios/Runner/GeneratedPluginRegistrant.*
**/ios/Runner/Runner.xcworkspace/
**/ios/Runner/Pods/
**/ios/Runner/Pods-*/
**/ios/Flutter/ephemeral/
**/android/.gradle/
**/android/app/**/*.keystore
**/android/local.properties

# Flutter app-specific generated files
sporthink_app/.dart_tool/
sporthink_app/build/
sporthink_app/.flutter-plugins
sporthink_app/.flutter-plugins-dependencies
sporthink_app/.metadata
sporthink_app/ios/Flutter/Flutter.framework
sporthink_app/ios/Flutter/Flutter.podspec
sporthink_app/ios/ServiceDefinitions.json
sporthink_app/ios/Runner/GeneratedPluginRegistrant.*
sporthink_app/ios/Runner/Runner.xcworkspace/
sporthink_app/ios/Runner/Pods/
sporthink_app/ios/Runner/Pods-*/
sporthink_app/ios/Flutter/ephemeral/
sporthink_app/android/.gradle/
sporthink_app/android/local.properties

# Generated reports and temporary files
terminal.txt
*.csv
*.tmp
*.temp

# Sensitive or local development dumps
*.sqlite
*.db

# Generated documentation
*.lock

# Misc
*.DS_Store

